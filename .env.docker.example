# Copy values from your local .env, then override Redis to point at the compose service.
# Usage: docker compose --env-file .env.docker up --build
#
# Or keep using .env and let docker-compose.yml override CELERY_*/REDIS_* via `environment:`.

DJANGO_ENV=localhost
SECRET_KEY=change-me
API_KEY=change-me

DB_NAME=pms_db
DB_USER=root
DB_PASSWORD=
DB_HOST=host.docker.internal
DB_PORT=3306

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
BACKGROUND_CACHE=redis
BACKGROUND_QUEUE=celery
CELERY_TASK_DEFAULT_QUEUE=background
